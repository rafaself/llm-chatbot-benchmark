# Bedrock target and default judge. The runner loads .env from the repository root.
# Values already set in the shell take precedence. Empty values are ignored.
# Do not commit real keys.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Temporary credentials also need a session token. Leave it unset for long-lived keys.
# AWS_SESSION_TOKEN=
