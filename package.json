{
  "name": "llm-chatbot-benchmark",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test": "python -m unittest discover -s tests -v && npm run test:integrations",
    "test:integrations": "PROMPTFOO_CONFIG_DIR=.promptfoo PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 node tests/test_tools.ts",
    "smoke": "python -m benchmark.run --smoke",
    "benchmark": "python -m benchmark.run",
    "lint:py": "ruff check .",
    "lint:ts": "eslint integrations tests",
    "lint": "npm run lint:py && npm run lint:ts",
    "format:py": "ruff format .",
    "format:ts": "prettier --write \"integrations/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.yaml\" \"config/*.json\"",
    "format": "npm run format:py && npm run format:ts",
    "format:check:py": "ruff format --check .",
    "format:check:ts": "prettier --check \"integrations/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.yaml\" \"config/*.json\"",
    "format:check": "npm run format:check:py && npm run format:check:ts",
    "typecheck:py": "mypy --strict benchmark tests",
    "typecheck:ts": "tsc --noEmit",
    "typecheck": "npm run typecheck:py && npm run typecheck:ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "promptfoo": "0.125.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
