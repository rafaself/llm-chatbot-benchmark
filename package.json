{
  "name": "llm-chatbot-benchmark",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "benchmark": "node src/run.ts",
    "full-benchmark": "node src/run.ts --live --allow-paid --models nova-micro nova-lite nemotron-nano nemotron-super gpt-oss-20b gpt-oss-120b qwen3-32b haiku-5.5 gpt-6-luna gpt-6.1-sol --allow-unverified-tools --max-requests 4060",
    "preview": "node src/run.ts --live --prepare-only",
    "smoke": "node src/run.ts --smoke",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/*.test.ts\" \"*.json\" \"*.yaml\" \"evaluation/{config,prompts}/*.json\" \"evaluation/*.yaml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/*.test.ts\" \"*.json\" \"*.yaml\" \"evaluation/{config,prompts}/*.json\" \"evaluation/*.yaml\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "promptfoo": "0.125.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.210",
    "@aws-sdk/credential-providers": "3.1162.0",
    "ai": "6.0.323",
    "commander": "15.0.0",
    "js-yaml": "5.4.3",
    "zod": "4.6.7"
  }
}
